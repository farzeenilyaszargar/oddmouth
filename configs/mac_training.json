{
  "status": "Implemented 15M-class design; training quality not yet measured",
  "parameter_limit": 15000000,
  "audio": {
    "sample_rate": 22050,
    "mel_bins": 80,
    "hop_length": 256,
    "fft_size": 1024,
    "fmax": 8000,
    "mel_feature_bytes_per_value": 2
  },
  "data_source": {
    "name": "DailyTalk (male speaker)",
    "hf_repo": "innovationm-ai/dailytalk-male",
    "hf_revision": "418c08304186f713068b9f6d0215cadfbf5dd148",
    "files": [
      "data/train-00000-of-00004.parquet",
      "data/train-00001-of-00004.parquet",
      "data/train-00002-of-00004.parquet",
      "data/train-00003-of-00004.parquet"
    ],
    "original_dataset": "https://github.com/keonlee9420/DailyTalk",
    "original_license": "CC-BY-SA-4.0 (authors' README says 'freely available for academic use with CC-BY-SA 4.0')",
    "mirror_label_not_authoritative": "Mirror card says apache-2.0; the original dataset licence governs",
    "eval_clips": 150
  },
  "architecture": {
    "text_width": 192,
    "text_layers": 4,
    "text_heads": 2,
    "text_ffn": 768,
    "duration_width": 192,
    "decoder_width": 256,
    "decoder_layers": 8,
    "decoder_heads": 4,
    "decoder_ffn": 1024,
    "time_width": 128,
    "vocoder_width": 384,
    "vocoder_layers": 6,
    "vocoder_ffn": 1152
  },
  "training": {
    "device": "mps",
    "dtype": "float32",
    "acoustic": {
      "batch_frames": 6000,
      "max_batch": 32,
      "learning_rate": 0.0002,
      "warmup_steps": 1000,
      "total_steps": 150000,
      "weight_decay": 0.01,
      "gradient_clip_norm": 1.0
    },
    "vocoder": {
      "batch_size": 16,
      "segment_frames": 32,
      "learning_rate": 0.0002,
      "betas": [
        0.8,
        0.99
      ],
      "total_steps": 300000,
      "mel_loss_weight": 45,
      "feature_matching_weight": 2,
      "adversarial_start_step": 2000,
      "gradient_clip_norm": 10.0
    },
    "synthesis_flow_steps": 8,
    "stages_run_in_separate_processes": true,
    "checkpoint_every_minutes": 10
  },
  "storage": {
    "max_download_chunk_bytes": 1000000000,
    "managed_data_cache_bytes": 1000000000,
    "vocoder_wave_fraction": 0.2,
    "minimum_free_disk_bytes": 5000000000,
    "note": "Parquet row groups (~90 MB) are streamed into memory, never saved raw. Prepared features stay under the 1 GB managed cache; only a fraction of clips keep waveforms for vocoder training."
  },
  "training_scope": {
    "initialization": "random_for_all_deployed_neural_components",
    "speaker_count": 1,
    "emotion_controls": false,
    "pretrained_tts_weights": false,
    "teacher_distillation": false,
    "other_speaker_training_audio": false
  },
  "cpu_share": 0.25,
  "cpu_share_note": "User limit: use at most 20-30% of total CPU. Enforced by oddmouth/throttle.py in prepare and train."
}
